{
	"name": "devai-harness",
	"description": "DEV-AI Harness (DSH): the embedded plugin-configurable harness runtime of the DEV-AI Suite, compatible with DeepSeek Harness v0.1.1-rc.2 plugins",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.19.0 || >=24"
