	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#4a5c72",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
